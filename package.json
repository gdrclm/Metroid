{
  "name": "last-harbour",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A vanilla JavaScript metroidvania — Act I, 43 playable rooms beneath a sleeping city.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node tools/server.mjs",
    "start": "node tools/server.mjs",
    "validate": "node tools/validate.mjs",
    "test": "node --test tests/*.test.js",
    "test:browser": "python tools/browser_smoke.py",
    "metrics": "node tools/metrics.mjs",
    "build": "node tools/build.mjs",
    "preview": "node tools/server.mjs --dist",
    "test:mobile": "python tools/mobile_smoke.py",
    "test:editor": "python tools/editor_smoke.py",
    "test:production": "python tools/production_smoke.py",
    "test:atmosphere": "python tools/atmosphere_smoke.py",
    "test:audio": "python tools/music_smoke.py",
    "test:guide": "python tools/guide_smoke.py",
    "test:hero-brain": "python tools/hero_brain_smoke.py",
    "test:guide-journey": "node tools/guide-continuous.mjs",
    "test:guide-expanded": "node tools/guide-continuous.mjs --expanded",
    "test:pier-browser": "python tools/pier_expansion_smoke.py",
    "test:station-browser": "python tools/station_expansion_smoke.py",
    "test:continuous": "node tools/continuous.mjs",
    "test:journey": "python tools/continuous_browser.py",
    "metrics:shortcuts": "node tools/shortcut_metrics.mjs"
  }
}
